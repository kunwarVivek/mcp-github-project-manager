# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# pnpm's content-addressable store, when configured with a local store-dir
.pnpm-store/

# Build output
build/
dist/
*.tsbuildinfo

# IDE and editor files
.idea/
.vscode/
.claude/
*.swp
*.swo

# Environment variables
# NOTE: .env.example and .env.test are tracked on purpose - they hold no
# secrets. Every other .env* file is ignored so a real credential file
# cannot be committed by accident.
.env*
!.env.example
!.env.test

# Test coverage
coverage/

# Logs
logs/
*.log

# Operating System
.DS_Store
Thumbs.db

# Cache directories
.mcp-cache/
.turbo/
.cache/

# Internal development files
handoffs/
.clinerules*
.roomodes*

# Session scratch files (kept locally, never committed - the durable
# equivalents live in `bd` issues and in .beads/)
HANDOFF.md

# Debug scripts (development only)
debug-*.js
.gitnexus

# Code-graph tool artifacts
.tokensave/
graphify-out/
**/graphify-out/
GRAPH_REPORT.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Husky's generated hook shims (husky writes its own .gitignore inside
# .husky/_ — listed here as well so the directory stays untracked even if
# that file is missing)
.husky/_

# Local Docker Compose overrides
docker-compose.override.yml

# Temporary / scratch directories
tmp/
.tmp/
*.orig
*.rej

# Generated by the E2E action sweep (see scripts/e2e-action-coverage.js)
src/__tests__/e2e/action-sweep-report.json

# Legacy toolchain leftovers
# The test runner is Vitest (not Jest) and the supported package managers are
# npm and pnpm (not bun). These entries exist so a leftover artifact from an
# older checkout cannot be re-committed by accident.
jest.config.*
jest.resolver.cjs
bun.lock
bun.lockb

# NOTE: package-lock.json AND pnpm-lock.yaml are both committed on purpose.
# The project supports npm and pnpm, and CI builds under both - do not
# ignore either lockfile.
