{
  "name": "mcp-github-project-manager",
  "version": "1.1.0",
  "description": "A Model Context Protocol (MCP) server for managing GitHub Projects",
  "type": "module",
  "exports": "./build/index.js",
  "bin": {
    "mcp-github-project-manager": "./build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "github",
    "projects",
    "llm",
    "model-context-protocol",
    "project-management"
  ],
  "author": "kvs <kunwarviveksingh@gmail.com> (https://github.com/kunwarVivek)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kunwarVivek/mcp-github-project-manager.git"
  },
  "homepage": "https://github.com/kunwarVivek/mcp-github-project-manager#readme",
  "bugs": {
    "url": "https://github.com/kunwarVivek/mcp-github-project-manager/issues"
  },
  "files": [
    "build/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x build/index.js && node scripts/fix-imports.js",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.ts --testPathPattern='e2e'",
    "test:e2e:tools": "vitest run --config vitest.config.ts --testPathPattern='tools'",
    "test:e2e:tools:real": "E2E_REAL_API=true vitest run --config vitest.config.ts --testPathPattern='tools'",
    "test:e2e:tools:github": "vitest run --config vitest.config.ts --testPathPattern='github-project-tools'",
    "test:e2e:tools:ai": "vitest run --config vitest.config.ts --testPathPattern='ai-task-tools'",
    "test:e2e:tools:workflows": "vitest run --config vitest.config.ts --testPathPattern='tool-integration-workflows'",
    "test:e2e:tools:real:github": "E2E_REAL_API=true vitest run --config vitest.config.ts --testPathPattern='github-project-tools'",
    "test:e2e:tools:real:ai": "E2E_REAL_API=true vitest run --config vitest.config.ts --testPathPattern='ai-task-tools'",
    "test:e2e:tools:real:workflows": "E2E_REAL_API=true vitest run --config vitest.config.ts --testPathPattern='tool-integration-workflows'",
    "test:e2e:tools:agent": "vitest run --config vitest.config.ts --testPathPattern='agent-orchestration'",
    "test:e2e:tools:real:agent": "E2E_REAL_API=true vitest run --config vitest.config.ts --testPathPattern='agent-orchestration'",
    "test:e2e:tools:platform": "vitest run --config vitest.config.ts --testPathPattern='platform-validation'",
    "test:e2e:tools:real:platform": "E2E_REAL_API=true vitest run --config vitest.config.ts --testPathPattern='platform-validation'",
    "test:ai": "vitest run --config vitest.config.ts --testPathPattern='(ai-services|ai-tools)'",
    "test:ai:watch": "vitest --config vitest.config.ts --testPathPattern='(ai-services|ai-tools)'",
    "test:ai:coverage": "vitest run --config vitest.config.ts --testPathPattern='(ai-services|ai-tools)' --coverage",
    "test:core": "vitest run --config vitest.config.ts --testPathIgnorePatterns='tests/(ai-services|ai-tools)'",
    "test:all": "npm run test && npm run test:e2e:tools",
    "test:all:real": "npm run test && npm run test:e2e:tools:real",
    "test:e2e:runner": "node scripts/run-e2e-tests.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "docs:api": "ts-node scripts/generate-openapi.ts",
    "docs:serve": "npx http-server docs -o api-explorer.html",
    "examples": "ts-node examples/basic/create-simple-project.ts",
    "prepublishOnly": "npm run build",
    "release": "node --loader ts-node/esm scripts/publish.js",
    "inspect": "npx @modelcontextprotocol/inspector node --loader ts-node/esm build/index.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/perplexity": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@types/graphlib": "^2.1.12",
    "ai": "^5.0.0",
    "cockatiel": "^3.2.1",
    "commander": "^14.0.0",
    "dotenv": "^16.5.0",
    "graphlib": "^2.1.8",
    "handlebars": "^4.7.8",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kunwarVivek"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^27.0.0",
    "@octokit/types": "^16.0.0",
    "@types/node": "^22.15.24",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "nock": "^14.0.4",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
