{
  "name": "mcp-github-project-manager",
  "version": "5.0.1",
  "description": "MCP server for AI-powered GitHub project management — 21 tools (175 actions), agent swarm orchestration, GitHub Actions/Releases/Branches, MCP Resources & Prompts, PRD-to-issues pipeline",
  "type": "module",
  "exports": "./build/index.js",
  "bin": {
    "mcp-github-project-manager": "build/bin.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "github",
    "github-projects",
    "github-projects-v2",
    "github-actions",
    "github-releases",
    "branch-protection",
    "project-management",
    "ai-agents",
    "agent-orchestration",
    "multi-agent",
    "agentic",
    "llm",
    "llm-tools",
    "claude",
    "ai-task-management",
    "prd-generator",
    "sprint-planning",
    "issue-triage",
    "task-automation",
    "ai-project-manager",
    "mcp-resources",
    "mcp-prompts",
    "swarm",
    "autonomous-agents"
  ],
  "author": "kvs <kunwarviveksingh@gmail.com> (https://github.com/kunwarVivek)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunwarVivek/mcp-github-project-manager.git"
  },
  "homepage": "https://github.com/kunwarVivek/mcp-github-project-manager#readme",
  "bugs": {
    "url": "https://github.com/kunwarVivek/mcp-github-project-manager/issues"
  },
  "files": [
    "build/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.test.json",
    "postbuild": "chmod +x build/bin.js build/index.js && node scripts/fix-imports.js",
    "start": "node build/bin.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude='**/e2e/**'",
    "test:e2e": "vitest run e2e",
    "test:e2e:tools": "vitest run tools",
    "test:e2e:tools:real": "E2E_REAL_API=true vitest run tools",
    "test:e2e:tools:github": "vitest run github-project-tools",
    "test:e2e:tools:ai": "vitest run ai-task-tools",
    "test:e2e:tools:workflows": "vitest run tool-integration-workflows",
    "test:e2e:tools:real:github": "E2E_REAL_API=true vitest run github-project-tools",
    "test:e2e:tools:real:ai": "E2E_REAL_API=true vitest run ai-task-tools",
    "test:e2e:tools:real:workflows": "E2E_REAL_API=true vitest run tool-integration-workflows",
    "test:e2e:tools:agent": "vitest run agent-orchestration",
    "test:e2e:tools:real:agent": "E2E_REAL_API=true vitest run agent-orchestration",
    "test:e2e:smoke": "E2E_TIER=smoke E2E_REAL_API=true vitest run agent-orchestration",
    "test:e2e:full": "E2E_TIER=full E2E_REAL_API=true vitest run agent-orchestration",
    "test:e2e:tools:platform": "vitest run platform-validation",
    "test:e2e:tools:real:platform": "E2E_REAL_API=true vitest run platform-validation",
    "test:pipeline": "E2E_REAL_API=true vitest run full-pipeline --testTimeout=120000",
    "test:pipeline:openai": "E2E_REAL_API=true AI_MAIN_MODEL=gpt-4o-mini vitest run full-pipeline --testTimeout=120000",
    "test:pipeline:google": "E2E_REAL_API=true AI_MAIN_MODEL=gemini-2.0-flash vitest run full-pipeline --testTimeout=120000",
    "test:ai": "vitest run unit/services/ai/ ai-tools issue-intelligence-tools ai-tasks/",
    "test:ai:watch": "vitest unit/services/ai/ ai-tools issue-intelligence-tools ai-tasks/",
    "test:ai:coverage": "vitest run unit/services/ai/ ai-tools issue-intelligence-tools ai-tasks/ --coverage",
    "test:core": "vitest run --exclude='**/unit/services/ai/**' --exclude='**/*ai-tools.test.ts' --exclude='**/issue-intelligence-tools.test.ts' --exclude='**/ai-tasks/**'",
    "test:all": "vitest run && vitest run tools",
    "test:all:real": "vitest run && E2E_REAL_API=true vitest run tools",
    "test:e2e:runner": "node scripts/run-e2e-tests.js",
    "test:e2e:sweep": "vitest run src/__tests__/e2e/tools/action-sweep.e2e.ts",
    "check:lockfiles": "node scripts/check-lockfiles.js",
    "check:docs": "tsx scripts/check-doc-counts.js",
    "test:e2e:coverage": "node scripts/e2e-action-coverage.js",
    "e2e": "node scripts/run-e2e-tests.js",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "docs:api": "tsx scripts/generate-openapi.ts",
    "schema:snapshot": "tsx scripts/update-schema-snapshot.ts",
    "docs:serve": "npx --yes http-server docs -o api-explorer.html",
    "examples": "tsx examples/basic/create-simple-project.ts",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.js",
    "inspect": "npx --yes @modelcontextprotocol/inspector node build/bin.js",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/google-vertex": "5.0.129",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/perplexity": "^5.0.26",
    "@ai-sdk/provider": "4.0.35",
    "@modelcontextprotocol/server": "^2.4.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/auth-oauth-user": "^6.0.4",
    "@octokit/openapi-types": "^29.0.1",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "ai": "^7.0.162",
    "cockatiel": "^4.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "graphlib": "^2.1.8",
    "handlebars": "^4.7.10",
    "jose": "^6.2.15",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kunwarVivek"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@octokit/types": "^18.0.0",
    "@types/graphlib": "^2.1.12",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "chalk": "^6.0.1",
    "nock": "^15.0.5",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
