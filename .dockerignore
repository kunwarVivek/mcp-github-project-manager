# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output - the image builds its own inside the container
build/
dist/
*.tsbuildinfo

# Test and coverage
coverage/
tests/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
jest.*.js
jest.*.mjs
jest.*.cjs

# Development files
.git/
.gitignore
.claude/
.agents/
.mcp-cache/
.planning/
.gitnexus/
.beads/
handoffs/
thoughts/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Environment (provided at runtime, never baked into the image)
.env*

# Documentation (not needed in container)
docs/
examples/
*.md
!README.md

# Debug scripts
debug-*.js
scripts/demo-test-client.sh
scripts/test-mcp*.sh
scripts/test-mcp*.js
scripts/README-test-client.md

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
.tmp/
*.log

# Config files not needed in container
vitest.config.ts
biome.json
.husky/
AGENTS.md
CLAUDE.md
.node-version
tsconfig.typecheck.json

# Local Docker Compose override
docker-compose.override.yml

# NOTE: package-lock.json and pnpm-lock.yaml are intentionally NOT ignored -
# the image installs from package-lock.json, and the pnpm lockfile is kept
# in the context so the Dockerfile can be switched to pnpm without touching
# this file.
