{
  "extends": "./tsconfig.json",
  "include": ["src/**/*", "examples/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.e2e.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "."
  }
}
