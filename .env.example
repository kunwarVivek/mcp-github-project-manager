# GitHub API Configuration
# GITHUB_OWNER and GITHUB_REPO are required. For the credential, pick ONE
# (first hit wins): GitHub App vars, --token, SECRETS_DIR/GITHUB_TOKEN,
# GITHUB_TOKEN, a stored OAuth login (`mcp-github-project-manager auth login`),
# or an authenticated `gh` CLI (disable with GH_CLI_TOKEN_FALLBACK=false;
# pin one of several gh accounts with GH_CLI_USER=<login>).
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org_name
GITHUB_REPO=your_repository_name

# GitHub OAuth device flow (optional, replaces GITHUB_TOKEN)
# Create an OAuth App or GitHub App with "Device Flow" enabled, then run
# `mcp-github-project-manager auth login`. The token is stored 0600 under
# $XDG_CONFIG_HOME/mcp-github-project-manager/github-oauth.json.
# GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id
# GITHUB_OAUTH_CLIENT_SECRET=        # optional, only used to revoke on `auth logout`
# GITHUB_OAUTH_SCOPES=repo project read:org
# GITHUB_OAUTH_TOKEN_FILE=/path/to/github-oauth.json

# GitHub App installation auth (optional, outranks every token source)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# E2E Test Configuration
# Token must have the following permissions:
# - repo (full)
# - project (full)
# - workflow
#
# Required scopes:
# - repo
# - write:org
# - project
# - admin:org

# Note: For E2E tests, it's recommended to use a dedicated test repository
# to avoid interfering with production data

# AI Provider Configuration
# At least one API key is required for AI functionality
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Gemini via Vertex AI with Google Application Default Credentials (optional)
# Credentials come from GOOGLE_APPLICATION_CREDENTIALS, `gcloud auth
# application-default login`, or the metadata server. When set, gemini-*
# models route to Vertex instead of GOOGLE_API_KEY.
# GOOGLE_VERTEX_PROJECT=your-gcp-project
# GOOGLE_VERTEX_LOCATION=us-central1

# AI Model Configuration
# Specify which models to use for different tasks.
# No defaults — configure the models you want to use.
# AI_MAIN_MODEL=claude-sonnet-4-20250514
# AI_RESEARCH_MODEL=sonar-pro
# AI_FALLBACK_MODEL=gpt-4o-mini
# AI_PRD_MODEL=claude-opus-5

# Per-Role AI Provider Configuration (optional)
# Each model role (main, research, fallback, prd) can independently use
# a different provider, API key, and endpoint. This lets you mix providers:
# e.g., OpenRouter for cheap daily tasks, direct Anthropic for PRD generation,
# local Ollama for fallback.
#
# Provider types: anthropic, openai, google, google-vertex, perplexity, openai-compatible
# "openai-compatible" works with any OpenAI-protocol endpoint:
# OpenRouter, Together, Groq, Ollama, LM Studio, Azure OpenAI, etc.
#
# AI_MAIN_PROVIDER=openai-compatible
# AI_MAIN_BASE_URL=https://openrouter.ai/api/v1
# AI_MAIN_API_KEY=sk-or-v1-your-openrouter-key
# AI_MAIN_MODEL=deepseek/deepseek-chat
#
# AI_PRD_PROVIDER=anthropic
# AI_PRD_API_KEY=sk-ant-your-anthropic-key
# AI_PRD_MODEL=claude-opus-5
#
# AI_FALLBACK_PROVIDER=openai-compatible
# AI_FALLBACK_BASE_URL=http://localhost:11434/v1
# AI_FALLBACK_API_KEY=ollama
# AI_FALLBACK_MODEL=llama3.1
#
# AI_RESEARCH_PROVIDER=perplexity
# AI_RESEARCH_API_KEY=pplx-your-key
# AI_RESEARCH_MODEL=sonar-pro

# AI Task Generation Configuration
MAX_TASKS_PER_PRD=50
DEFAULT_COMPLEXITY_THRESHOLD=7
MAX_SUBTASK_DEPTH=3
AUTO_DEPENDENCY_DETECTION=true
AUTO_EFFORT_ESTIMATION=true

# GitHub AI Integration
AUTO_CREATE_PROJECT_FIELDS=true
AI_BATCH_SIZE=10
# Per-session token budget for the AI task pipeline (0 = unlimited)
AI_SESSION_TOKEN_LIMIT=0

# Secrets (optional)
# Load any secret from a mounted file named after it (Docker/k8s convention);
# a file SECRETS_DIR/<NAME> takes precedence over the <NAME> env var.
# SECRETS_DIR=/run/secrets

# Webhooks & Events (optional)
# Signature validation fails closed: with no WEBHOOK_SECRET, webhooks are
# rejected unless WEBHOOK_ALLOW_UNSIGNED=true (trusted dev only).
# WEBHOOK_SECRET=your_webhook_secret
# WEBHOOK_ALLOW_UNSIGNED=false
# WEBHOOK_PORT=3001
# SYNC_ENABLED=true
# SSE_ENABLED=true
# The listener binds loopback by default; set WEBHOOK_HOST=0.0.0.0 to expose it.
# WEBHOOK_HOST=127.0.0.1
# Proxy IPs whose X-Forwarded-For is trusted for rate limiting (default: none)
# WEBHOOK_TRUSTED_PROXIES=

# Audit log, OpenTelemetry, rate-limit floor (optional)
# AUDIT_LOG_ENABLED=false
# AUDIT_LOG_PATH=.mcp-audit/mutations.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=mcp-github-project-manager
# RATE_LIMIT_FLOOR=100

# Event endpoint authentication (/events/*) - requires a bearer token and fails closed:
# with nothing configured every /events/* request gets 503. Configure either or both.
# EVENTS_AUTH_TOKEN=a_long_random_shared_secret
# OAUTH_ISSUER=https://auth.example.com
# OAUTH_AUDIENCE=https://mcp.example.com
# OAUTH_JWKS_URI=                    # optional; discovered from the issuer
# OAUTH_REQUIRED_SCOPES=events:read
# OAUTH_RESOURCE_URL=https://mcp.example.com
# EVENTS_ALLOW_UNAUTHENTICATED=false # trusted dev only

# Cache (optional)
# MAX_CACHE_ENTRIES=10000

# Logging (optional)
# LOG_FORMAT=text       # 'text' (human-readable) or 'json' (newline-delimited JSON to stderr)
# LOG_LEVEL=info        # debug, info, warn, error

# Tool Exposure (optional)
# Comma-separated list of compound tool GROUPS to expose to MCP clients.
# These are group names, not tool names - a tool name here exposes nothing.
# Default: all (exposes all 20 compound tools). discover_tools is always available.
# Available groups:
#   core    - manage_project, manage_issues, manage_prs, manage_milestones,
#             manage_sprints, manage_labels, manage_automation, manage_iterations,
#             manage_status_updates, manage_branches, manage_releases, manage_workflows
#   ai      - ai_generate, ai_analyze, ai_plan
#   agents  - agent_work, agent_manage
#   events  - manage_events
#   system  - system, discover_tools
MCP_TOOL_GROUPS=all

# Agent Orchestration (optional — constants, not env vars; shown for reference)
# These are compile-time defaults in src/domain/agent-orchestration-types.ts.
# Override by forking the source. Shown here for documentation:
# DEFAULT_HEARTBEAT_TIMEOUT_MINUTES=30     # stale-agent detection window
# DEFAULT_AGENT_BUDGET_TOKENS=500000       # default per-agent token budget
# AGENT_REGISTRY_LABEL=agent-registry      # GitHub issue label for agent registry
# Agent custom fields are auto-provisioned when AUTO_CREATE_PROJECT_FIELDS=true